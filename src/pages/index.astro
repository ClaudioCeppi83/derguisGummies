---
import ScrollWorldCanvas from '../components/ScrollWorldCanvas.astro';

const portfolio = [
  {
    name: 'Biotina + Colágeno + Vitamina C',
    badge: 'Producto Estrella 3 en 1',
    flavor: 'Frutos Rojos (60 Gummies)',
    benefit: 'Piel firme, uñas fuertes y cabello con brillo natural de adentro hacia afuera.',
    price: '$14.990 CLP'
  },
  {
    name: 'Viti Apple Cider Vinegar',
    badge: 'Control & Digestión',
    flavor: 'Manzana Natural (120g)',
    benefit: 'Regulación glicémica para evitar picos de insulina, control de peso y salud digestiva.',
    price: '$14.990 CLP'
  },
  {
    name: 'Viti L-Triptófano DREAMS',
    badge: 'Rutina Nocturna',
    flavor: 'Cherry (120g)',
    benefit: 'Combate el insomnio, promueve la relajación profunda y mejora tu ánimo al despertar.',
    price: '$14.990 CLP'
  },
  {
    name: 'Viti Probióticos + Prebióticos',
    badge: 'Equilibrio Intestinal',
    flavor: 'Naranja (120g)',
    benefit: 'Solución rica y efectiva contra el estreñimiento que regenera la flora digestiva.',
    price: '$14.990 CLP'
  }
];

const bundles = [
  {
    title: 'Opción 1: Prueba Inicial',
    subtitle: '1 Frasco (Suministro 1 Mes / 60 Gomitas)',
    price: '$14.990 CLP',
    savings: 'Precio regular + envío',
    popular: false,
    cta: 'Comprar 1 Frasco',
    features: ['60 gomitas sabor frutos rojos', 'Dosis diaria: 2 ositos al día', 'Despacho a todo Chile']
  },
  {
    title: 'Pack Rutina 3 Meses',
    subtitle: '3 Frascos (180 Gomitas - Renovación Celular)',
    price: '$35.990 CLP',
    savings: 'Ahorras 20% + ENVÍO GRATIS',
    popular: true,
    cta: 'Quiero Mi Pack 3 Meses',
    features: [
      'El 65% de nuestras clientas elige este pack',
      'Ciclo completo de 90 días para renovación capilar y dérmica',
      'Envío 100% Gratis a todo Chile',
      'Garantía de satisfacción de 30 días'
    ]
  },
  {
    title: 'Pack Dúo Transformación In & Out',
    subtitle: 'Biotina Trío Belleza + Vinagre de Manzana o Dreams',
    price: '$26.990 CLP',
    savings: 'Ahorras 10% en tu rutina Día & Noche',
    popular: false,
    cta: 'Armar Mi Pack Dúo',
    features: ['Combina belleza integral + digestión o sueño profundo', 'Sin molestias estomacales', 'Pago 100% seguro']
  }
];

const faqs = [
  {
    q: '¿Engordan o tienen mucha azúcar?',
    a: 'Nuestras Gummies Funcionales tienen un aporte calórico mínimo y están formuladas específicamente para integrarse en rutinas de bienestar, fitness y control metabólico sin dañar tu colágeno.'
  },
  {
    q: '¿A qué hora del día debo tomarlas?',
    a: 'La dosis ideal es de 2 ositos al día, preferiblemente por la mañana junto a tu desayuno o después de tu primer vaso de agua para activar la absorción de nutrientes.'
  },
  {
    q: '¿Cuánto tardan en verse los resultados?',
    a: 'La sensación de hidratación en la piel comienza entre las semanas 2 y 3. Para observar mayor densidad capilar y uñas sin quiebres, el ciclo biológico recomendado es de 6 a 12 semanas de constancia.'
  },
  {
    q: '¿Tienen contraindicaciones?',
    a: 'Son suplementos alimentarios seguros para adultos. Como indica nuestro etiquetado reglamentario en Chile, no se recomienda para menores de 8 años (15 años en L-Triptófano), embarazadas o nodrizas salvo indicación médica.'
  }
];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gummies Funcionales & Viti | Biotina + Colágeno + Vitamina C en Chile</title>
    <meta
      name="description"
      content="Piel firme, cabello brillante y uñas fuertes sin pastillas difíciles de tragar. La fórmula 3 en 1 con Biotina, Colágeno y Vitamina C en deliciosas gomitas."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#160b11] text-rose-50 antialiased selection:bg-rose-500 selection:text-white">
    <!-- Fondo interactivo Scroll World -->
    <ScrollWorldCanvas totalFrames={480} />

    <!-- Barra superior fija -->
    <header class="fixed top-0 inset-x-0 z-40 backdrop-blur-md bg-[#160b11]/60 border-b border-white/10">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="h-3 w-3 rounded-full bg-rose-500 animate-pulse"></span>
          <span class="font-display font-bold tracking-wide text-lg text-white">
            GUMMIES FUNCIONALES <span class="text-rose-400 text-xs font-sans uppercase ml-1">× Viti Chile</span>
          </span>
        </div>
        <a
          href="#ofertas"
          class="bg-rose-600 hover:bg-rose-500 text-white text-sm font-semibold px-4 py-2 rounded-full transition shadow-lg shadow-rose-600/30"
        >
          Quiero Probar Mis Gummies
        </a>
      </div>
    </header>

    <main class="relative z-10">
      <!-- SECCIÓN 1: HERO (ABOVE THE FOLD) -->
      <section class="min-h-screen flex items-center pt-24 pb-16 px-4">
        <div class="max-w-3xl mx-auto text-center backdrop-blur-md bg-[#160b11]/55 p-8 md:p-12 rounded-3xl border border-white/15 shadow-2xl">
          <p class="inline-flex items-center gap-2 text-xs md:text-sm uppercase tracking-widest text-rose-300 font-semibold bg-rose-950/80 border border-rose-500/30 px-4 py-1.5 rounded-full mb-6">
            ✨ La nueva forma rica, práctica y natural de cuidarte por dentro
          </p>
          <h1 class="font-display text-4xl md:text-6xl font-bold leading-tight text-white mb-6">
            Piel firme, cabello brillante y uñas fuertes: <span class="text-rose-400 italic">en un solo bocado al día.</span>
          </h1>
          <p class="text-base md:text-xl text-rose-100/90 mb-8 leading-relaxed">
            La fórmula <strong>3 en 1 con Biotina (1000 mcg), Colágeno Hidrolizado y Vitamina C</strong> clínicamente sinérgica que convierte tu rutina de belleza en tu momento favorito del día. ¡Que nadie te diga SEÑORA!
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href="#ofertas"
              class="w-full sm:w-auto bg-gradient-to-r from-rose-600 to-pink-600 hover:from-rose-500 hover:to-pink-500 text-white font-bold text-lg px-8 py-4 rounded-full shadow-xl shadow-rose-600/40 transition transform hover:-translate-y-0.5"
            >
              Quiero Probar Mis Gummies →
            </a>
          </div>
          <p class="mt-4 text-xs text-rose-200/80">
            🚚 Envío rápido a todo Chile &nbsp;|&nbsp; 🔒 Pago 100% Seguro &nbsp;|&nbsp; ★★★★★ 4.9/5 (+5.000 frascos entregados)
          </p>
        </div>
      </section>

      <!-- SECCIÓN 2: AGITACIÓN DEL PROBLEMA Y MECANISMO ÚNICO -->
      <section class="min-h-screen flex items-center py-20 px-4">
        <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-8 items-center">
          <div class="backdrop-blur-md bg-[#160b11]/65 p-8 rounded-3xl border border-white/15">
            <span class="text-rose-400 text-xs font-bold uppercase tracking-widest">Los 3 enemigos de tu piel</span>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-white mt-2 mb-4">
              El secreto del resultado no es solo el ingrediente: es la constancia.
            </h2>
            <p class="text-rose-100/85 mb-6 leading-relaxed">
              El <strong>Sol</strong> acelera el fotoenvejecimiento, el <strong>Estrés</strong> inflama y cansa tus rasgos, y el <strong>Azúcar</strong> degrada el colágeno y la elastina. ¿Por qué fracasan los suplementos tradicionales? Porque tragar cápsulas grandes y amargas se siente como un castigo que abandonas a la semana.
            </p>
            <div class="p-4 rounded-2xl bg-rose-950/60 border border-rose-500/30">
              <p class="text-sm font-medium text-rose-200">
                💡 <strong>Rutina In & Out:</strong> Bloqueador solar por fuera para evitar manchas + 2 ositos de Gummies Funcionales por dentro para regenerar tejidos desde la raíz.
              </p>
            </div>
          </div>

          <!-- SECCIÓN 3: MATRIZ DE CONTRASTE -->
          <div class="backdrop-blur-md bg-[#160b11]/75 p-8 rounded-3xl border border-rose-500/30 shadow-xl">
            <h3 class="font-display text-2xl font-bold text-white mb-6 text-center">
              Gummies Funcionales 🍬 vs. Pastillas Convencionales 💊
            </h3>
            <div class="space-y-4 text-sm">
              <div class="p-3.5 rounded-xl bg-white/5 flex justify-between items-center">
                <span class="font-semibold text-rose-200">Sabor y Experiencia</span>
                <span class="text-emerald-400 font-bold">✓ Delicioso sabor Frutos Rojos</span>
              </div>
              <div class="p-3.5 rounded-xl bg-white/5 flex justify-between items-center">
                <span class="font-semibold text-rose-200">Hábito y Constancia</span>
                <span class="text-emerald-400 font-bold">✓ Querrás tomarlas todos los días</span>
              </div>
              <div class="p-3.5 rounded-xl bg-white/5 flex justify-between items-center">
                <span class="font-semibold text-rose-200">Digestión y Absorción</span>
                <span class="text-emerald-400 font-bold">✓ Sin pesadez ni dolor estomacal</span>
              </div>
              <div class="p-3.5 rounded-xl bg-white/5 flex justify-between items-center">
                <span class="font-semibold text-rose-200">Sinergia Completa</span>
                <span class="text-emerald-400 font-bold">✓ Trío 3 en 1 en 2 ositos diarios</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECCIÓN 4: RESPALDO CIENTÍFICO + CALCULADORA DE HIDRATACIÓN -->
      <section class="min-h-screen flex items-center py-20 px-4">
        <div class="max-w-5xl mx-auto space-y-10">
          <div class="text-center max-w-3xl mx-auto backdrop-blur-md bg-[#160b11]/65 p-8 rounded-3xl border border-white/15">
            <span class="text-rose-400 text-xs font-bold uppercase tracking-widest">Ciencia Nutracéutica Sinérgica</span>
            <h2 class="font-display text-3xl md:text-5xl font-bold text-white mt-2 mb-4">
              ¿Por qué nuestra fórmula 3 en 1 sí funciona?
            </h2>
            <p class="text-rose-100/85">
              Tomar colágeno aislado no basta. Nuestra formulación une los tres eslabones biológicos que tu cuerpo necesita para sintetizar tejido joven:
            </p>
          </div>

          <div class="grid md:grid-cols-3 gap-6">
            <div class="backdrop-blur-md bg-[#160b11]/70 p-6 rounded-2xl border border-white/15">
              <div class="text-2xl mb-2">🍊 Vitamina C Activadora</div>
              <p class="text-sm text-rose-100/85 leading-relaxed">
                Requisito biológico indispensable: activa las enzimas que unen, estabilizan y endurecen las fibras de colágeno, ordenando a tus células producir más proteína estructural.
              </p>
            </div>
            <div class="backdrop-blur-md bg-[#160b11]/70 p-6 rounded-2xl border border-white/15">
              <div class="text-2xl mb-2">🧬 Biotina (Vitamina B7)</div>
              <p class="text-sm text-rose-100/85 leading-relaxed">
                El cuerpo no la produce por sí solo. Favorece el metabolismo de grasas, proteínas y carbohidratos para producir <strong>queratina</strong> desde el folículo capilar y la matriz de tus uñas.
              </p>
            </div>
            <div class="backdrop-blur-md bg-[#160b11]/70 p-6 rounded-2xl border border-white/15">
              <div class="text-2xl mb-2">💧 Calculadora de Agua In & Out</div>
              <p class="text-xs text-rose-200/80 mb-3">
                Multiplica el efecto de tus Gummies con tu hidratación exacta (Tu peso × 35 ml):
              </p>
              <div class="flex items-center gap-2">
                <input
                  id="weight-input"
                  type="number"
                  placeholder="Tu peso en kg (ej. 65)"
                  class="w-full px-3 py-2 rounded-lg bg-black/50 border border-rose-500/40 text-white text-sm"
                />
                <button
                  id="calc-water-btn"
                  class="bg-rose-600 hover:bg-rose-500 px-3 py-2 rounded-lg text-xs font-bold uppercase"
                >
                  Calcular
                </button>
              </div>
              <p id="water-result" class="mt-2 text-xs font-semibold text-emerald-400">
                Ej: 65 kg × 35 ml = 2,27 litros al día.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- PORTAFOLIO VITI NUTRITION & WELLNESS -->
      <section class="min-h-screen flex items-center py-20 px-4">
        <div class="max-w-6xl mx-auto w-full">
          <div class="text-center mb-12 backdrop-blur-md bg-[#160b11]/65 p-6 rounded-3xl border border-white/15 max-w-2xl mx-auto">
            <span class="text-rose-400 text-xs font-bold uppercase tracking-widest">Ecosistema Viti Nutrition & Wellness</span>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-white mt-2">
              Soluciones funcionales para cada momento de tu día
            </h2>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {portfolio.map((item) => (
              <div class="backdrop-blur-md bg-[#160b11]/75 p-6 rounded-3xl border border-white/15 flex flex-col justify-between">
                <div>
                  <span class="inline-block text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-rose-500/20 text-rose-300 border border-rose-500/30 mb-3">
                    {item.badge}
                  </span>
                  <h3 class="font-display text-xl font-bold text-white mb-1">{item.name}</h3>
                  <p class="text-xs text-rose-300 mb-3">{item.flavor}</p>
                  <p class="text-sm text-rose-100/80 leading-relaxed mb-6">{item.benefit}</p>
                </div>
                <div class="pt-4 border-t border-white/10 flex items-center justify-between">
                  <span class="font-bold text-lg text-white">{item.price}</span>
                  <a href="#ofertas" class="text-xs font-bold text-rose-400 hover:text-rose-300">
                    Seleccionar →
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- SECCIÓN 5: CONFIGURACIÓN DE OFERTA (PRICING & BUNDLES) -->
      <section id="ofertas" class="min-h-screen flex items-center py-24 px-4">
        <div class="max-w-6xl mx-auto w-full">
          <div class="text-center mb-12 backdrop-blur-md bg-[#160b11]/70 p-8 rounded-3xl border border-white/15 max-w-3xl mx-auto">
            <span class="text-rose-400 text-xs font-bold uppercase tracking-widest">Oferta Directa Exclusiva Chile</span>
            <h2 class="font-display text-3xl md:text-5xl font-bold text-white mt-2 mb-3">
              Elige tu Tratamiento Gummies Funcionales
            </h2>
            <p class="text-rose-100/85 text-sm md:text-base">
              Garantía libre de riesgo de 30 días. Los dermatólogos y especialistas recomiendan un ciclo mínimo de 60 a 90 días para una renovación celular y capilar completa.
            </p>
          </div>

          <div class="grid md:grid-cols-3 gap-8 items-stretch">
            {bundles.map((b) => (
              <div
                class={`backdrop-blur-md rounded-3xl p-8 flex flex-col justify-between border ${
                  b.popular
                    ? 'bg-gradient-to-b from-rose-950/90 to-[#160b11]/95 border-rose-400 shadow-2xl shadow-rose-600/30 scale-105'
                    : 'bg-[#160b11]/75 border-white/15'
                }`}
              >
                <div>
                  {b.popular && (
                    <span class="inline-block bg-rose-500 text-white text-xs font-bold uppercase px-3 py-1 rounded-full mb-4">
                      ★ Más Popular (65% de ventas)
                    </span>
                  )}
                  <h3 class="font-display text-2xl font-bold text-white">{b.title}</h3>
                  <p class="text-xs text-rose-200/80 mt-1 mb-6">{b.subtitle}</p>
                  <div class="text-4xl font-extrabold text-white mb-1">{b.price}</div>
                  <p class="text-xs font-semibold text-emerald-400 mb-6">{b.savings}</p>
                  <ul class="space-y-3 text-sm text-rose-100/90 mb-8">
                    {b.features.map((feat) => (
                      <li class="flex items-start gap-2">
                        <span class="text-rose-400 font-bold">✓</span>
                        <span>{feat}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <a
                  href="https://bit.ly/ContactoGummiesFuncionales"
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`w-full text-center font-bold py-4 rounded-full transition ${
                    b.popular
                      ? 'bg-rose-500 hover:bg-rose-400 text-white shadow-lg shadow-rose-500/40'
                      : 'bg-white/10 hover:bg-white/20 text-white'
                  }`}
                >
                  {b.cta}
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- SECCIÓN 7: MANEJO DE OBJECIONES (FAQ) -->
      <section class="py-20 px-4">
        <div class="max-w-3xl mx-auto backdrop-blur-md bg-[#160b11]/75 p-8 md:p-12 rounded-3xl border border-white/15">
          <h2 class="font-display text-3xl font-bold text-white text-center mb-8">
            Preguntas Frecuentes
          </h2>
          <div class="space-y-4">
            {faqs.map((item) => (
              <details class="group bg-white/5 rounded-2xl p-5 border border-white/10">
                <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center">
                  <span>{item.q}</span>
                  <span class="text-rose-400 group-open:rotate-45 transition-transform text-xl">+</span>
                </summary>
                <p class="mt-3 text-sm text-rose-100/80 leading-relaxed">{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    </main>

    <!-- SECCIÓN 8: STICKY ADD-TO-CART (MÓVIL) -->
    <div class="fixed bottom-0 inset-x-0 z-40 md:hidden backdrop-blur-lg bg-[#160b11]/90 border-t border-rose-500/30 p-3 flex items-center justify-between">
      <div>
        <div class="text-xs font-bold text-white">Pack Rutina 3 Meses (-20%)</div>
        <div class="text-[11px] text-emerald-400">Envío Gratis Chile • Garantía 30 días</div>
      </div>
      <a
        href="#ofertas"
        class="bg-rose-600 text-white text-xs font-bold px-5 py-2.5 rounded-full shadow-lg shadow-rose-600/40"
      >
        Comprar Ahora
      </a>
    </div>

    <script>
      const input = document.getElementById('weight-input') as HTMLInputElement | null;
      const btn = document.getElementById('calc-water-btn');
      const out = document.getElementById('water-result');
      btn?.addEventListener('click', () => {
        const w = Number(input?.value || 0);
        if (w > 20 && w < 250 && out) {
          const liters = ((w * 35) / 1000).toFixed(2);
          out.textContent = `Tu meta ideal: ${liters} litros de agua al día (${w * 35} ml) + 2 Gummies Funcionales.`;
        }
      });
    </script>
  </body>
</html>
