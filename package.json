{
  "name": "derguis-gummies-scroll-world",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "keyframes": "node .agents/skills/build-scroll-world-landing/scripts/01-generate-keyframes.js",
    "clips:dry": "node .agents/skills/build-scroll-world-landing/scripts/02-generate-clips.js --dry-run",
    "clips:spike": "node .agents/skills/build-scroll-world-landing/scripts/02-generate-clips.js --spike 1",
    "clips:all": "node .agents/skills/build-scroll-world-landing/scripts/02-generate-clips.js --all",
    "clips:local": "node .agents/skills/build-scroll-world-landing/scripts/02-generate-clips.js --local-ffmpeg",
    "encode:scroll": "bash .agents/skills/build-scroll-world-landing/scripts/03-encode-scroll.sh ./public/media/raw-clips ./public/media/scroll",
    "deploy": "npm run build && npx firebase-tools deploy --only hosting"
  },
  "dependencies": {
    "@astrojs/tailwind": "^5.1.0",
    "@google/genai": "^1.0.0",
    "astro": "^4.15.0",
    "tailwindcss": "^3.4.10"
  }
}
